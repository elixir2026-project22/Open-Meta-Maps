.DS_Store
**/__pycache__/
*.py[cod]
**/node_modules/

# generated outputs of the tool and local experiments.  The real folders live OUTSIDE this repository (../Experiments); the entries below are
# local symlinks (or generated files) that keep the tool working on the developer's machine.
/results/
/layout_atlas/results/*
!/layout_atlas/results/tool/
!/layout_atlas/results/about/

# build outputs (rebuilt by `python3 project.py setup`)
/layout_atlas/build/
/layout_atlas/build_native/

# optional / large local data (not redistributed with the open-core checkout); the real files may live outside this repository (../LocalData)
/data/atlas.sqlite
# Derived Mapper crosswalk (built from identifier_bridge + available models); do not track
/data/annotation_bridge.json
/data/annotation_bridge.json.gz
/data/extensions/brenda/*
!/data/extensions/brenda/SOURCE.json
!/data/extensions/brenda/modules.json.gz
/data/extensions/human_maps/*
!/data/extensions/human_maps/SOURCE.json
!/data/extensions/human_maps/modules.json.gz
!/data/extensions/human_maps/import_audit.json
/data/extensions/wikipathways_geometry/*
!/data/extensions/wikipathways_geometry/SOURCE.json
!/data/extensions/wikipathways_geometry/modules.json.gz
/data/references
/data/source_inputs/archives/human_maps.zip*
/data/references/yeast_original
/data/references/yeast_maps

