.DS_Store
**/__pycache__/
*.py[cod]
**/node_modules/

# generated outputs of the tool and local experiments.  The real folders live OUTSIDE this repository (../Experiments); the entries below are
# local symlinks (or generated files) that keep the tool working on the developer's machine.
/results/
/layout_atlas/results/*
!/layout_atlas/results/tool/
!/layout_atlas/results/about/
!/layout_atlas/results/micromap_extension/
/layout_atlas/results/micromap_extension/*
!/layout_atlas/results/micromap_extension/annotation_bridge.json

# build outputs (rebuilt by `python3 project.py setup`)
/layout_atlas/build/
/layout_atlas/build_native/

# data that is not redistributable (CC BY-NC-SA 4.0 / unverified provenance / licence conflicts); the real files live OUTSIDE this repository (../LocalData)
/data/atlas.sqlite
/data/extensions/micromap
/data/extensions/brenda
/data/references
/data/source_inputs/archives/human_maps.zip*
/data/source_inputs/archives/yeast_maps.zip*

