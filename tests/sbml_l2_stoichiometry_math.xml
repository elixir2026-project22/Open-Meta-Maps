<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level2/version4" level="2" version="4">
  <model id="l2_stoichiometry_math">
    <listOfCompartments>
      <compartment id="c" size="1"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="A" name="A" compartment="c" initialConcentration="0"/>
      <species id="B" name="B" compartment="c" initialConcentration="0"/>
      <species id="E" name="E" compartment="c" initialConcentration="0"/>
    </listOfSpecies>
    <listOfReactions>
      <reaction id="r1" name="r1" reversible="false">
        <listOfReactants>
          <speciesReference species="A">
            <stoichiometryMath>
              <math xmlns="http://www.w3.org/1998/MathML">
                <apply><plus/><cn type="integer">1</cn><cn type="integer">1</cn></apply>
              </math>
            </stoichiometryMath>
          </speciesReference>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="B" stoichiometry="1"/>
        </listOfProducts>
        <listOfModifiers>
          <modifierSpeciesReference species="E"/>
        </listOfModifiers>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
